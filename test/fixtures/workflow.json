{
  "schemaVersion": 1,
  "name": "small-feature",
  "description": "A minimal user-authored feature workflow.",
  "maxConcurrency": 2,
  "nodes": [
    {
      "id": "inspect",
      "kind": "agent",
      "needs": [],
      "inputs": [],
      "outputs": ["implementation-plan"],
      "objective": "Inspect the project and prepare a small plan.",
      "retries": 1,
      "role": "scout",
      "access": "read",
      "workspace": "shared",
      "backend": "subagent",
      "fanOut": 1
    },
    {
      "id": "approve",
      "kind": "gate",
      "needs": ["inspect"],
      "inputs": ["implementation-plan"],
      "outputs": ["approved-plan"],
      "objective": "Approve the implementation plan.",
      "retries": 0,
      "approval": "user"
    },
    {
      "id": "implement",
      "kind": "agent",
      "needs": ["approve"],
      "inputs": ["approved-plan"],
      "outputs": ["candidate"],
      "objective": "Implement the approved plan in isolation.",
      "retries": 1,
      "role": "worker",
      "access": "write",
      "workspace": "isolated",
      "backend": "subagent",
      "fanOut": 1
    },
    {
      "id": "verify",
      "kind": "verify",
      "needs": ["implement"],
      "inputs": ["candidate"],
      "outputs": ["verification-evidence"],
      "objective": "Verify the isolated candidate.",
      "retries": 1,
      "checks": ["tests", "diagnostics", "diff-review", "secret-scan"],
      "workspace": "isolated",
      "workspaceSource": "candidate"
    }
  ]
}
